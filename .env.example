# Copy to .env.local (git-ignored) and fill in real values:
#   copy .env.example .env.local      (PowerShell / cmd)
#   cp .env.example .env.local        (bash)
# Every variable must also be declared in src/env.ts, which validates it
# (`next build` fails on an invalid or missing required value).
# Commit only this file: never put real secrets here.

# --- Server-only (not exposed to browser code) ---
# Set automatically by Next.js (development | test | production).
# NODE_ENV=development
# DATABASE_URL=postgres://user:password@localhost:5432/app

# --- Client (inlined into the browser bundle at build time; must start with NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_NAME=nextjs-pet-template
