# Copy to .env.local (git-ignored) and fill in real values:
#   copy .env.example .env.local      (PowerShell / cmd)
#   cp .env.example .env.local        (bash)
# Every variable must also be declared in src/env.ts, which validates it.
# Commit only this file: never put real secrets here.
#
# All service variables are optional. Without Supabase the app runs in demo
# mode (in-memory backend seeded with demo entries); without OpenRouter it uses
# a fake AI that streams canned replies.

# --- Server-only (not exposed to browser code) ---
# SUPABASE_SERVICE_ROLE_KEY=
# DEMO_USER_EMAIL=
# DEMO_USER_PASSWORD=
# OPENROUTER_API_KEY=
# OPENROUTER_CHAT_MODEL=openai/gpt-4.1-mini
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# AI_DAILY_LIMIT=10

# --- Client (inlined into the browser bundle at build time; must start with NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_NAME="Echo Journal"
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_REPO_URL=https://github.com/edgergard/echo-journal
